ADDR=:8080
DATABASE_URL=postgres://apofocus:apofocus@localhost:5432/apofocus?sslmode=disable
PHOTO_ROOTS=/absolute/path/to/photo/archive
PHOTO_LIBRARY_ROOT=/absolute/path/to/apofocus-library
APOFOCUS_IMPORT_ROOTS=/absolute/path/to/inbox
APOFOCUS_BACKUP_ROOT=/Volumes/ApoFocusBackup/PostgreSQL
APOFOCUS_BACKUP_STATUS=/absolute/path/to/app-state/backup-status.json
APOFOCUS_BACKUP_VOLUME_UUID=
EMBEDDING_SERVICE_URL=http://127.0.0.1:8090
THUMBNAIL_ROOTS=/absolute/path/to/apofocus-library
EMBEDDING_MODEL=ViT-B-32
EMBEDDING_WEIGHTS=laion2b_s34b_b79k
EMBEDDING_BATCH_SIZE=16
AUTO_TAG_LIMIT=4
AUTO_TAG_MIN_SCORE=0.18
PHOTO_THUMBNAIL_MAX_EDGE=1600
RAW_THUMBNAIL_MAX_EDGE=960
RAW_THUMBNAIL_QUALITY=36
DERIVATIVE_IMAGE_QUALITY=42
DERIVATIVE_IMAGE_SPEED=6
WHISPER_MODEL=base
WHISPER_LANGUAGE=
WHISPER_DOWNLOAD_ROOT=/absolute/path/to/model-cache/whisper
VIDEO_SAMPLE_SECONDS=10
VIDEO_KEYFRAME_MAX_EDGE=960
MAX_VIDEO_SEGMENTS=300
AUDIO_SEGMENT_SECONDS=30
MAX_AUDIO_SEGMENTS=600
